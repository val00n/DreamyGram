<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:minHeight="1dp"
              android:descendantFocusability="blocksDescendants">

    <View
        android:id="@+id/messageDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#40E0E0E0" />

    <LinearLayout
        android:id="@+id/messageCaptionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/messageCaptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:text="Forwarded from @null"
            android:maxLines="1"
            android:textColor="@android:color/secondary_text_dark"
            android:textStyle="italic"
            android:textSize="16sp"
            android:paddingTop="2dp"
            android:padding="4dp"
            android:layout_marginLeft="3dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#20E0E0E0" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/messageRoot"
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/messageTextLayout"
            android:layout_margin="4dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/messageTitleRow"
                android:layout_alignParentBottom="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/messageDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:text="XX:XX"
                    android:textColor="@android:color/secondary_text_dark"
                    android:textSize="17sp"
                    android:paddingTop="2dp"
                    android:paddingRight="4dp"/>
                <ImageView
                    android:id="@+id/messageStatus"
                    android:src="@drawable/ic_wait"
                    android:layout_gravity="center"
                    android:layout_width="14dp"
                    android:layout_height="14dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Me"
                    android:textColor="@android:color/primary_text_dark"
                    android:textSize="20sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_alignParentTop="true"
                    android:gravity="right"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/messageQuoteLayout"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="#10E0E0E0"
                android:layout_marginBottom="2dp"
                android:orientation="horizontal"
                android:gravity="right">

                <TextView
                    android:id="@+id/messageQuoteText"
                    android:padding="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quote text"
                    android:maxLines="2"
                    android:linksClickable="true"
                    android:textColor="@android:color/secondary_text_dark"
                    android:textSize="16sp"
                    android:gravity="right"/>
                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:background="#75E0E0E0"/>
            </LinearLayout>

            <TextView
                android:id="@+id/messageText"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:linksClickable="true"
                android:text="Bottom text"
                android:textColor="@android:color/secondary_text_dark"
                android:textSize="17sp"
                android:gravity="right"/>
        </LinearLayout>

        <ImageView
            android:layout_margin="4dp"
            android:id="@+id/messageAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/avatar_placeholder"/>
    </LinearLayout>

</LinearLayout>