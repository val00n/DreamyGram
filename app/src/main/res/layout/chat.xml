<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/chatHeaderLayout"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:padding="4dp"
        android:background="#35000000">

        <RelativeLayout
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp">
            <TextView
                android:id="@+id/chatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="@android:color/primary_text_dark"
                android:textSize="24sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/chatStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:text="Loading..."
                android:textColor="@android:color/secondary_text_dark"
                android:textSize="17sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </RelativeLayout>

        <ImageButton
            android:id="@+id/chatOptionsButton"
            android:src="@android:drawable/ic_menu_more"
            android:layout_gravity="center"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
    </LinearLayout>

    <View
        android:id="@+id/chatHeaderSeparator"
        android:layout_below="@id/chatHeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        style="@style/HorizontalDivider" />

    <ListView
        android:layout_below="@id/chatHeaderSeparator"
        android:layout_above="@+id/chatBottomContainer"
        android:id="@+id/chatMessages"
        android:stackFromBottom="true"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:layout_alignParentBottom="true"
        android:id="@id/chatBottomContainer"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/chatBottomContainerContent"
            android:visibility="gone"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#35000000">
            <LinearLayout
                android:visibility="gone"
                android:id="@+id/chatTooltip"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:layout_gravity="bottom"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@android:color/darker_gray" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/chatTooltipPreview"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginLeft="6dp"
                        android:layout_marginRight="6dp"
                        android:background="#20E0E0E0"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/chatTooltipText"
                        android:padding="6dp"
                        android:textSize="16sp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:text="Tooltip: useful text"/>
                    <ImageButton
                        android:id="@+id/chatTooltipCloseButton"
                        android:src="@android:drawable/ic_delete"
                        android:background="@null"
                        android:layout_width="28dp"
                        android:layout_height="28dp"/>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_gravity="bottom"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                style="@style/HorizontalDivider" />

            <LinearLayout
                android:visibility="visible"
                android:layout_marginTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/chatInputEditText"
                    android:hint="Message..."
                    android:maxLines="5"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"/>
                <ImageButton
                    android:id="@+id/chatAttachButton"
                    android:src="@android:drawable/ic_menu_add"
                    android:layout_gravity="center"
                    android:layout_width="48dp"
                    android:layout_height="48dp"/>
                <ImageButton
                    android:id="@+id/chatSendButton"
                    android:src="@android:drawable/ic_menu_send"
                    android:layout_gravity="center"
                    android:layout_width="48dp"
                    android:layout_height="48dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    
    <ImageButton
        android:id="@+id/chatBackToBottomButton"
        android:layout_above="@id/chatBottomContainer"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="16dp"
        android:layout_marginRight="16dp"
        android:src="@android:drawable/ic_menu_revert"
        android:visibility="gone"
        android:layout_width="52dp"
        android:layout_height="52dp"/>

    <ProgressBar
        android:id="@+id/chatProgressBar"
        android:layout_centerInParent="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"/>

    <TextView
        android:id="@+id/chatNetworkStatusText"
        android:layout_above="@id/chatBottomContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="3dp"
        android:visibility="gone"
        android:background="@android:color/background_dark"
        android:textColor="@android:color/primary_text_dark_nodisable"
        android:text="Network lost..."/>
</RelativeLayout>