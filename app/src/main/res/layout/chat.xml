<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:padding="4dp">

            <RelativeLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp">
                <TextView
                    android:id="@+id/chatTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User"
                    android:textColor="@android:color/primary_text_dark"
                    android:textSize="24sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/chatStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:text="Status"
                    android:textColor="@android:color/secondary_text_dark"
                    android:textSize="17sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </RelativeLayout>

            <ImageButton
                android:id="@+id/chatOptionsButton"
                android:src="@android:drawable/ic_menu_more"
                android:layout_gravity="center"
                android:layout_width="48dp"
                android:layout_height="48dp"/>
        </LinearLayout>
        <View
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray" />

        <ListView
            android:id="@+id/chatMessages"
            android:stackFromBottom="true"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:visibility="gone"
            android:id="@+id/chatTooltip"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:layout_gravity="bottom"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/darker_gray" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center">
                <TextView
                    android:id="@+id/chatTooltipText"
                    android:padding="6dp"
                    android:textSize="16sp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:text="Tooltip: useful text"/>
                <ImageButton
                    android:id="@+id/chatTooltipCloseButton"
                    android:src="@android:drawable/ic_delete"
                    android:background="@null"
                    android:layout_width="28dp"
                    android:layout_height="28dp"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray" />
        <LinearLayout
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/chatInputEditText"
                android:hint="Message..."
                android:maxLines="5"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"/>
            <ImageButton
                android:id="@+id/chatAttachButton"
                android:src="@android:drawable/ic_menu_add"
                android:layout_gravity="center"
                android:layout_width="48dp"
                android:layout_height="48dp"/>
            <ImageButton
                android:id="@+id/chatSendButton"
                android:src="@android:drawable/ic_menu_send"
                android:layout_gravity="center"
                android:layout_width="48dp"
                android:layout_height="48dp"/>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/chatProgressBar"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"/>
</FrameLayout>