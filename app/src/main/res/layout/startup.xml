<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent">

    <ProgressBar
        android:id="@+id/startupProgressBar"
        android:layout_centerInParent="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <RelativeLayout
        android:id="@+id/startupWelcomeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <ImageView
            android:id="@+id/startupAppIcon"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_centerInParent="true"
            android:src="@android:drawable/sym_def_app_icon"/>
        <TextView
            android:layout_above="@+id/startupAppDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/app_name"
            android:textColor="@android:color/primary_text_dark"
            android:textStyle="bold"
            android:textSize="28sp"/>
        <TextView
            android:id="@+id/startupAppDesc"
            android:layout_above="@id/startupAppIcon"
            android:layout_width="256dp"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/startup_welcome_description"
            android:gravity="center"
            android:layout_marginTop="6dp"/>
        <Button
            android:id="@+id/startupWelcomeNextButton"
            android:layout_centerInParent="true"
            android:layout_width="128dp"
            android:layout_height="wrap_content"
            android:text="@string/action_next"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="72dp"
            android:layout_marginBottom="16dp"/>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/startupWarningLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <TextView
            android:id="@+id/startupWarningTitle"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/startup_warning_title"
            android:textColor="@android:color/primary_text_dark"
            android:textStyle="bold"
            android:textSize="28sp"
            android:layout_marginTop="12dp"/>
        <ScrollView
            android:layout_below="@id/startupWarningTitle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_above="@+id/startupWarningNextButton">
            <TextView
                android:padding="6dp"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textColor="@android:color/primary_text_dark"
                android:text="@string/startup_warning_text"
                android:layout_marginTop="6dp"/>
        </ScrollView>
        <Button
            android:id="@+id/startupWarningNextButton"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_width="148dp"
            android:layout_height="wrap_content"
            android:text="@string/startup_continue"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/startupLoginTypesLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_title"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_centerHorizontal="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="24dp"/>
        <LinearLayout
            android:id="@+id/startupLoginButtonsLayout"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/startupQRLoginButton"
                android:layout_centerInParent="true"
                android:layout_width="196dp"
                android:layout_height="wrap_content"
                android:text="@string/startup_qr_login"
                android:layout_alignParentBottom="true"/>
            <Button
                android:id="@+id/startupPhoneLoginButton"
                android:layout_centerInParent="true"
                android:layout_width="196dp"
                android:layout_height="wrap_content"
                android:text="@string/startup_phone_login"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="2dp"/>
            <Button
                android:id="@+id/startupInstanceSettingsButton"
                android:layout_centerInParent="true"
                android:layout_width="196dp"
                android:layout_height="wrap_content"
                android:text="@string/settings_instance_settings"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/startupChosenInstanceText"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/startupLoginButtonsLayout"
            android:text="@string/startup_chosen_instance_placeholder"
            android:gravity="center"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="2dp"/>

        <TextView
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/startup_phone_login_warning"
            android:gravity="center"
            android:textStyle=""
            android:layout_marginBottom="12dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>

</RelativeLayout>