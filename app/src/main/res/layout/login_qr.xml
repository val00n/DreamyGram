<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:orientation="vertical" android:layout_width="match_parent"
                android:layout_height="match_parent" android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_title"
        android:textSize="48sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="24dp"/>

    <ProgressBar
        android:id="@+id/loginQRProgressBar"
        android:layout_centerInParent="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/loginQRCaptchaLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/loginQRCaptchaImageView"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@android:color/black"
            android:layout_marginBottom="8dp"/>
        <EditText
            android:maxLines="1"
            android:id="@+id/loginQRCaptchaEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_captcha_code"/>
        <Button
            android:id="@+id/loginQRCaptchaSubmitButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_submit"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/loginQRImageView"
        android:visibility="gone"
        android:layout_centerInParent="true"
        android:layout_width="196dp"
        android:layout_height="196dp"
        android:background="@android:color/black"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_warning_new_accounts"
        android:textSize="16sp"
        android:textStyle="italic"
        android:gravity="center"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="12dp"
        android:padding="4dp"/>

</RelativeLayout>