<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="horizontal"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:descendantFocusability="blocksDescendants"
              android:padding="12dp"
    android:id="@+id/instanceRoot">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/instanceTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="mp.example.com"
            android:textColor="@android:color/primary_text_dark"
            android:textSize="18sp"
            android:maxLines="1"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/instanceAuthStatusTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Session: unauthorized"
            android:textColor="@android:color/secondary_text_dark"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end"/>
        <TextView
            android:id="@+id/instancePingTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ping: XXms"
            android:textColor="@android:color/secondary_text_dark"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center">
        <ImageButton
            android:id="@+id/instanceEditButton"
            android:src="@android:drawable/ic_menu_preferences"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
    </LinearLayout>

</LinearLayout>