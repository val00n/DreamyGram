<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="Global: XX.XX/XX MB"
            android:textSize="26dp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="Avatars: XX.XX MB"
            android:textSize="20dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="Media: XX.XX MB"
            android:textSize="20dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="Chats: XX.XX MB"
            android:textSize="20dp"
            android:layout_marginBottom="8dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="Storage saved: XX.XX MB"
            android:textSize="20dp"
            android:layout_marginBottom="24dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:orientation="vertical"
            android:layout_margin="4dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Clear avatar cache"
                    android:textSize="16dp"/>
                <Button
                    android:id="@+id/cacheSettingsAvatarClear"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:text="Clear"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Clear media cache"
                    android:textSize="16dp"/>
                <Button
                    android:id="@+id/cacheSettingsMediaClear"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:text="Clear"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Clear chats cache"
                    android:textSize="16dp"/>
                <Button
                    android:id="@+id/cacheSettingsChatsClear"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:text="Clear"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Clear storage saved"
                    android:textSize="16dp"/>
                <Button
                    android:id="@+id/cacheSettingsStorageSavedClear"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:text="Clear"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Avatar cache limit (in MB)"
                    android:textSize="16dp"/>
                <EditText
                    android:id="@+id/cacheSettingsAvatarEditText"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="XX"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Media cache limit (in MB)"
                    android:textSize="16dp"/>
                <EditText
                    android:id="@+id/cacheSettingsMediaEditText"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="XX"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chats cache limit (in MB)"
                    android:textSize="16dp"/>
                <EditText
                    android:id="@+id/cacheSettingsChatsEditText"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="XX"/>
            </LinearLayout>

            <CheckBox
                android:id="@+id/cacheSettingsAvatarStoreCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Store avatar cache"
                android:checked="true"/>
            <CheckBox
                android:id="@+id/cacheSettingsMediaStoreCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Store media cache"
                android:checked="true"/>
            <CheckBox
                android:id="@+id/cacheSettingsChatsStoreCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Store chats cache"
                android:checked="true"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Avatar cache TTL (days)"
                    android:textSize="16dp"/>
                <EditText
                    android:id="@+id/cacheSettingsAvatarTTLEditText"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="XX"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Media cache TTL (days)"
                    android:textSize="16dp"/>
                <EditText
                    android:id="@+id/cacheSettingsMediaTTLEditText"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="XX"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</ScrollView>