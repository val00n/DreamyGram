<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/cacheSettingsGlobalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/cache_settings_global_label"
            android:textSize="26dp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>
        <TextView
            android:id="@+id/cacheSettingsAvatarsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/cache_settings_avatars_label"
            android:textSize="20dp"/>
        <TextView
            android:id="@+id/cacheSettingsMediaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/cache_settings_media_label"
            android:textSize="20dp"/>
        <TextView
            android:id="@+id/cacheSettingsChatsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/cache_settings_chats_label"
            android:textSize="20dp"
            android:layout_marginBottom="18dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            style="@style/HorizontalDivider"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/cacheSettingsStorageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/cache_settings_storage_label"
            android:textSize="20dp"
            android:layout_marginBottom="6dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            style="@style/HorizontalDivider"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:orientation="vertical"
            android:layout_margin="4dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cache_settings_clear_avatar_cache"
                    android:textSize="16dp"/>
                <Button
                    android:id="@+id/cacheSettingsAvatarClear"
                    android:layout_width="100dp"
                    android:layout_height="45dp"
                    android:text="@string/action_clear"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cache_settings_clear_media_cache"
                    android:textSize="16dp"/>
                <Button
                    android:id="@+id/cacheSettingsMediaClear"
                    android:layout_width="100dp"
                    android:layout_height="45dp"
                    android:text="@string/action_clear"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cache_settings_clear_chats_cache"
                    android:textSize="16dp"/>
                <Button
                    android:id="@+id/cacheSettingsChatsClear"
                    android:layout_width="100dp"
                    android:layout_height="45dp"
                    android:text="@string/action_clear"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cache_settings_clear_storage_cache"
                    android:textSize="16dp"/>
                <Button
                    android:id="@+id/cacheSettingsStorageSavedClear"
                    android:layout_width="100dp"
                    android:layout_height="45dp"
                    android:text="@string/action_clear"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cache_settings_avatar_cache_limit"
                    android:textSize="16dp"/>
                <EditText
                    android:id="@+id/cacheSettingsAvatarEditText"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_number"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cache_settings_media_cache_limit"
                    android:textSize="16dp"/>
                <EditText
                    android:id="@+id/cacheSettingsMediaEditText"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_number"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cache_settings_chats_cache_limit"
                    android:textSize="16dp"/>
                <EditText
                    android:id="@+id/cacheSettingsChatsEditText"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_number"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cache_settings_avatar_cache_ttl"
                    android:textSize="16dp"/>
                <EditText
                    android:id="@+id/cacheSettingsAvatarTTLEditText"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_number"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cache_settings_media_cache_ttl"
                    android:textSize="16dp"/>
                <EditText
                    android:id="@+id/cacheSettingsMediaTTLEditText"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_number"/>
            </LinearLayout>

            <CheckBox
                android:id="@+id/cacheSettingsAvatarStoreCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cache_settings_store_avatar_cache"
                android:checked="true"
                android:layout_marginTop="4dp"/>
            <CheckBox
                android:id="@+id/cacheSettingsMediaStoreCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cache_settings_store_media_cache"
                android:checked="true"
                android:layout_marginTop="4dp"/>
            <CheckBox
                android:id="@+id/cacheSettingsChatsStoreCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cache_settings_store_chats_cache"
                android:checked="true"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

</ScrollView>