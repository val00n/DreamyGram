<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_weight="1"
        android:layout_height="0dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/instance_edit_instance"
                android:textAlignment="center"
                android:textSize="48sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/instance_edit_base_url"
                android:textSize="18sp"
                android:layout_marginBottom="2dp"/>
            <EditText
                android:id="@+id/instanceEditBaseURLEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="@string/hint_example_com"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/instance_edit_api_endpoint"
                android:textSize="18sp"
                android:layout_marginBottom="2dp"/>
            <EditText
                android:id="@+id/instanceEditAPIEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="@string/hint_api_php"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/instance_edit_avatar_endpoint"
                android:textSize="18sp"
                android:layout_marginBottom="2dp"/>
            <EditText
                android:id="@+id/instanceEditAvatarEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="@string/hint_ava_php"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/instance_edit_file_endpoint"
                android:textSize="18sp"
                android:layout_marginBottom="2dp"/>
            <EditText
                android:id="@+id/instanceEditFileEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="@string/hint_file_php"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/instance_edit_voice_endpoint"
                android:textSize="18sp"
                android:layout_marginBottom="2dp"/>
            <EditText
                android:id="@+id/instanceEditVoiceEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="@string/hint_voice_php"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/instance_edit_qr_endpoint"
                android:textSize="18sp"
                android:layout_marginBottom="2dp"/>
            <EditText
                android:id="@+id/instanceEditQREditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="@string/hint_qrcode_php"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/instance_edit_api_version"
                android:textSize="18sp"
                android:layout_marginBottom="2dp"/>
            <EditText
                android:id="@+id/instanceEditAPIVersionEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="@string/hint_api_version"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/instance_edit_password"
                android:textSize="18sp"
                android:layout_marginBottom="2dp"/>
            <EditText
                android:id="@+id/instanceEditPasswordEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="@string/hint_password_placeholder"/>

            <CheckBox
                android:id="@+id/instanceEditCheckCertsCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/instance_edit_enable_certs_check"
                android:checked="true"
                android:layout_marginBottom="8dp"/>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/instanceEditSaveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/instance_edit_save"
        android:layout_margin="4dp"/>
</LinearLayout>