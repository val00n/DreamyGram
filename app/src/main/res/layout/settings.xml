<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="match_parent">

   <LinearLayout
       android:layout_margin="6dp"
       android:orientation="vertical"
       android:layout_width="match_parent"
       android:layout_height="wrap_content">
       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="@string/settings_title"
           android:gravity="center"
           android:textSize="48sp"
           android:textStyle="bold"
           android:layout_gravity="center"
           android:layout_marginBottom="18dp"/>

       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="2dp"
           android:gravity="center">
           <TextView
               android:layout_width="0dp"
               android:layout_height="wrap_content"
               android:layout_weight="1"
               android:text="@string/settings_dialogs_count"
               android:textSize="16dp"/>
           <EditText
               android:id="@+id/settingsDialogsCountEditText"
               android:layout_width="100dp"
               android:layout_height="wrap_content"
               android:hint="@string/hint_number"/>
       </LinearLayout>

       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="2dp"
           android:gravity="center">
           <TextView
               android:layout_width="0dp"
               android:layout_height="wrap_content"
               android:layout_weight="1"
               android:text="@string/settings_messages_count"
               android:textSize="16dp"/>
           <EditText
               android:id="@+id/settingsMessagesCountEditText"
               android:layout_width="100dp"
               android:layout_height="wrap_content"
               android:hint="@string/hint_number"/>
       </LinearLayout>

       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="2dp"
           android:gravity="center">
           <TextView
               android:layout_width="0dp"
               android:layout_height="wrap_content"
               android:layout_weight="1"
               android:text="@string/settings_dialogs_poll_time"
               android:textSize="16dp"/>
           <EditText
               android:id="@+id/settingsDialogPollEditText"
               android:layout_width="100dp"
               android:layout_height="wrap_content"
               android:hint="@string/hint_number"/>
       </LinearLayout>

       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="2dp"
           android:gravity="center">
           <TextView
               android:layout_width="0dp"
               android:layout_height="wrap_content"
               android:layout_weight="1"
               android:text="@string/settings_messages_poll_time"
               android:textSize="16dp"/>
           <EditText
               android:id="@+id/settingsMessagesPollEditText"
               android:layout_width="100dp"
               android:layout_height="wrap_content"
               android:hint="@string/hint_number"/>
       </LinearLayout>

       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="@string/settings_chat_style"
           android:textSize="16sp"
           android:layout_marginTop="8dp"
           android:layout_marginBottom="4dp"/>
       <Spinner
           android:id="@+id/settingsChatStyleSpinner"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginBottom="8dp"/>

       <CheckBox
           android:id="@+id/settingsLoadAvatarsCheckBox"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="@string/settings_load_avatars"
           android:checked="true"
           android:layout_marginTop="4dp"/>
       <CheckBox
           android:id="@+id/settingsLoadMediaCheckBox"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="@string/settings_load_media"
           android:checked="true"
           android:layout_marginTop="4dp"/>
       <CheckBox
           android:id="@+id/settingsDialogPollCheckBox"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="@string/settings_dialogs_polling"
           android:checked="true"
           android:layout_marginTop="4dp"/>

       <CheckBox
           android:id="@+id/settingsChatPollCheckBox"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="@string/settings_chats_polling"
           android:checked="true"
           android:layout_marginTop="4dp"/>

       <Button
           android:id="@+id/settingsInstancesButton"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="@string/settings_instance_settings"/>
       <Button
           android:id="@+id/settingsCacheButton"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="@string/settings_cache_management"
           android:layout_marginBottom="12dp"/>
   </LinearLayout>

</ScrollView>