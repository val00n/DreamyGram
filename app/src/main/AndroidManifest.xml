<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.val00n.dmpg">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:name="com.val00n.dmpg.App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">>

        <activity
        android:label="@string/app_name"
        android:name="com.val00n.dmpg.ui.StartupActivity"
        android:configChanges="orientation|keyboardHidden|screenSize">
        <intent-filter >
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>

        <activity android:name="com.val00n.dmpg.ui.main.MainActivity" android:windowSoftInputMode="stateHidden" android:label="@string/app_name" android:configChanges="orientation|keyboardHidden|screenSize"/>
        <activity android:name=".ui.chat.ChatActivity" android:theme="@style/AppTheme.NoActionBar" android:configChanges="orientation|keyboardHidden|screenSize"/>
        <activity android:name="com.val00n.dmpg.ui.login.LoginPhoneActivity" android:configChanges="orientation|keyboardHidden|screenSize" android:label="Phone login"/>
        <activity android:name="com.val00n.dmpg.ui.login.LoginQRActivity" android:configChanges="orientation|keyboardHidden|screenSize" android:label="QR login"/>
        <activity android:name=".ui.login.Login2FAActivity" android:configChanges="orientation|keyboardHidden|screenSize" android:label="2FA login"/>
        <activity android:name="com.val00n.dmpg.ui.settings.instances.InstanceSettingsActivity" android:configChanges="orientation|keyboardHidden|screenSize" android:label="Instances"/>
        <activity android:name="com.val00n.dmpg.ui.settings.instances.InstanceEditActivity" android:configChanges="orientation|keyboardHidden|screenSize" android:label="Edit instance"/>
        <activity android:name=".ui.settings.CacheSettingsActivity" android:windowSoftInputMode="stateHidden" android:configChanges="orientation|keyboardHidden|screenSize" android:label="Cache management"/>
        <activity android:name=".ui.settings.SettingsActivity" android:windowSoftInputMode="stateHidden" android:configChanges="orientation|keyboardHidden|screenSize" android:label="Settings"/>
        <activity android:name=".ui.chat.ImageViewerActivity" android:theme="@style/AppTheme.Fullscreen" android:configChanges="orientation|keyboardHidden|screenSize" />
        <activity android:name=".ui.chat.VideoViewerActivity" android:theme="@style/AppTheme.Fullscreen" android:configChanges="orientation|keyboardHidden|screenSize" />

    </application>
</manifest>
