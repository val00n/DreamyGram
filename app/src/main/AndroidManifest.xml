<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.val00n.dmpg">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name="com.val00n.dmpg.App"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true">

        <activity
        android:label="@string/app_name"
        android:name="com.val00n.dmpg.ui.startup.StartupActivity">
        <intent-filter >
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>

        <activity android:name="com.val00n.dmpg.ui.main.MainActivity" android:label="@string/app_name"/>
        <activity android:name=".ui.chat.ChatActivity" android:label="Chat"/>
        <activity android:name="com.val00n.dmpg.ui.login.LoginPhoneActivity" android:label="Phone login"/>
        <activity android:name="com.val00n.dmpg.ui.login.LoginQRActivity" android:label="QR login"/>
        <activity android:name=".ui.login.Login2FAActivity" android:label="2FA login"/>
        <activity android:name="com.val00n.dmpg.ui.settings.instances.InstanceSettingsActivity" android:label="Instances"/>
        <activity android:name="com.val00n.dmpg.ui.settings.instances.InstanceEditActivity" android:label="Edit instance"/>
        <activity android:name=".ui.settings.SettingsActivity" android:label="Settings"/>

    </application>
</manifest>
